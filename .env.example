# =============================================================================
# tsa-portfolio — Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to `server/.env` for local development (the server loads it
# via dotenv when cwd is `server/`, or pass `--env-file=server/.env` from root).
#
# On Vercel, add every variable below in Project Settings → Environment
# Variables (Production / Preview / Development).
# =============================================================================

# --- App ---
NODE_ENV=development
LOG_LEVEL=info
DATABASE_NAME=tsa_portfolio
CLIENT_URL=http://localhost:5178
# Optional: public URL of the API when it differs from CLIENT_URL
# SERVER_URL=

# --- MongoDB ---
# Atlas connection string (see README for egress allow-listing)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# --- Session ---
# Strong random secret — generate with: openssl rand -hex 32
SESSION_SECRET=
SESSION_MAX_AGE=86400000

# --- Email (Brevo) ---
BREVO_API_KEY=
EMAIL_OWNER=you@example.com

# --- Cron / queue ---
# Protects the cron endpoint; generate with: openssl rand -hex 32
CRON_SECRET=

# --- Memcachier (cache) ---
MEMCACHIER_SERVERS=
MEMCACHIER_USERNAME=
MEMCACHIER_PASSWORD=

# --- Cloudinary (uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
