{
  "name": "tsa-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Techstudio Academy Portfolio — React Router 7 client + Express API, deployed to Render as a single full-stack web service.",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "node ./node_modules/typescript/bin/tsc --project shared/tsconfig.json && npm run build --workspace client",
    "lint": "npm run lint --workspace client",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspace server"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "vite": "^8.1.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "connect-mongo@6.0.0": true,
    "express-session@1.19.0": true,
    "memjs@1.3.2": true,
    "@types/express@5.0.6": true,
    "@types/express-session@1.19.0": true,
    "@types/connect-mongo@3.1.2": true,
    "mongodb-memory-server@11.2.0": true
  }
}
